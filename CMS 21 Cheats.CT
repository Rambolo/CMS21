alloc(resultMem,$1000,resultHook)

label(greenReturn)
label(resultReturn)
label(fullCondition)


// =======================================
// FORCE GREEN BONUS + 100% CONDITION
// =======================================

greenMem:
  // Restore original RBX
  mov rbx,[rsp+68]

  // RDI points to the 'instant' output bool
  mov byte ptr [rdi],01

  // Return 100% condition (1.0f)
  movss xmm0,[fullCondition]

  jmp greenReturn

align 4
fullCondition:
  dd (float)1.0


// =======================================
// FORCE SUCCESSFUL REPAIR RESULT
// =======================================

resultMem:
  // BarType.Success = 1
  mov edi,1

  // Preserve original instruction
  mov rbx,rcx

  jmp resultReturn


// =======================================
// INSTALL HOOKS
// =======================================

greenHook:
  jmp greenMem
  nop 3

greenReturn:

resultHook:
  jmp resultMem

resultReturn:


