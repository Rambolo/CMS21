  // XMM0 contains the new requested fluid level
  // [RDI+10] contains the current fluid level

  ucomiss xmm0,[rdi+10]

  // Ignore unordered comparisons (NaN)
  jp original

  // New level &gt; current level
  ja fillFluid

  jmp original

fillFluid:
  // Force the fluid to 100%
  movss xmm0,[fullValue]
  movaps xmm6,xmm0
  jmp original

