[ENABLE]

define(garageHook,GameAssembly.dll+DC5DAE)
define(skipSkills,GameAssembly.dll+B37854)
define(keepPoints,GameAssembly.dll+B3793B)

assert(garageHook,C6 83 A0 00 00 00 01)
assert(skipSkills,7E 69)
assert(keepPoints,C7 43 30 00 00 00 00)

alloc(garageMem,$1000,garageHook)

label(garageReturn)
label(garageRestore)
label(garageDone)

// Skip the skills loop in UpgradeSystem.UnlockAll
skipSkills:
  db EB 69

// Prevent UnlockAll from resetting skill points
keepPoints:
  db 90 90 90 90 90 90 90

garageMem:

  // Preserve registers and flags
  pushfq
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11

  // One-time execution
  cmp byte ptr [garageDone],01
  je garageRestore

  // RBX = SkillsTab
  // +80 = UpgradeSystem
  mov rax,[rbx+80]
  test rax,rax
  je garageRestore

  // Ensure skills list is initialized
  mov r8,[rax+18]
  test r8,r8
  je garageRestore

  // Ensure garage upgrades list exists
  mov r8,[rax+20]
  test r8,r8
  je garageRestore

  // Check garage upgrades count
  cmp dword ptr [r8+18],00
  jle garageRestore

  // Call UpgradeSystem.UnlockAll(true)
  //
  // Our patches make this:
  // - Skip skills
  // - Unlock garage upgrades
  // - Preserve skill points
  // - Update garage objects

  mov rcx,rax
  mov edx,1

  sub rsp,20
  call GameAssembly.dll+B377F0
  add rsp,20

  // Save progression
  mov rcx,[rbx+80]
  xor edx,edx

  sub rsp,20
  call GameAssembly.dll+B36240
  add rsp,20

  // Mark complete if Save returned true
  test al,al
  je garageRestore

  mov byte ptr [garageDone],01

garageRestore:

  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  pop rax
  popfq

  // Original SkillsTab instruction
  mov byte ptr [rbx+000000A0],01

  jmp garageReturn

align 4

garageDone:
  db 00

garageHook:
  jmp garageMem
  nop 2

garageReturn:

[DISABLE]

garageHook:
  db C6 83 A0 00 00 00 01

skipSkills:
  db 7E 69

keepPoints:
  db C7 43 30 00 00 00 00

