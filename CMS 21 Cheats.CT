  // Preserve original flags
  pushfq

  // Check whether transaction is negative
  test edi,edi
  jns normal

  // Negative transaction: undo the deduction
  sub dword ptr [rcx+0000002A0],edi

normal:
  // Restore flags
  popfq

  // Original instruction
  mov eax,[rcx+000002A0]

  jmp return

freeHook:
  jmp newmem
  nop

return:

