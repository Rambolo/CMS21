[ENABLE]

define(skillHook,GameAssembly.dll+DC5DA4)

assert(skillHook,33 D2 48 8B CB)

alloc(skillMem,$1000,skillHook)

label(skillReturn)
label(skillLoop)
label(levelLoop)
label(nextSkill)
label(saveSkills)
label(restore)
label(unlockDone)

skillMem:

  // Preserve flags and volatile registers
  pushfq
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11

  // Already executed?
  cmp byte ptr [unlockDone],01
  je restore

  // RBX = SkillsTab instance
  // +80 = UpgradeSystem
  mov r10,[rbx+80]
  test r10,r10
  je restore

  // UpgradeSystem +18 = UpgradesForPoints
  mov r10,[r10+18]
  test r10,r10
  je restore

  // Read List&lt;Upgrade&gt;.Count
  mov r9d,[r10+18]
  test r9d,r9d
  jle restore

  // Safety limit
  cmp r9d,1000
  ja restore

  // List&lt;Upgrade&gt; backing array
  mov r10,[r10+10]
  test r10,r10
  je restore

  xor edx,edx

skillLoop:

  cmp edx,r9d
  jge saveSkills

  // Each Upgrade struct is 0x18 bytes
  mov eax,edx
  imul rax,rax,18

  // Upgrade.Unlocked (bool[])
  mov rcx,[r10+rax+30]
  test rcx,rcx
  je nextSkill

  // Number of levels
  mov eax,[rcx+18]
  test eax,eax
  jle nextSkill

  cmp eax,1000
  ja nextSkill

  // First bool[] element
  lea r8,[rcx+20]

levelLoop:

  mov byte ptr [r8],01

  inc r8
  dec eax

  jne levelLoop

nextSkill:

  inc edx
  jmp skillLoop

saveSkills:

  // Save changes using the game's method
  mov rcx,[rbx+80]
  test rcx,rcx
  je restore

  xor edx,edx

  // Windows x64 shadow space
  sub rsp,20

  call GameAssembly.dll+B36240

  add rsp,20

  // Save() returns bool
  test al,al
  je restore

  // Mark as completed
  mov byte ptr [unlockDone],01

restore:

  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  pop rax
  popfq

  // Original instructions
  xor edx,edx
  mov rcx,rbx

  jmp skillReturn

align 4

unlockDone:
  db 00

skillHook:
  jmp skillMem

skillReturn:

[DISABLE]

skillHook:
  db 33 D2 48 8B CB

dealloc(skillMem)

