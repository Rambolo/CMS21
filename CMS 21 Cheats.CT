[ENABLE]
assert(CMS21_Ready,01)
 
define(fluidHook,GameAssembly.dll+1285939)
assert(fluidHook,48 8B 5F 18 F3 0F 11 47 10)

alloc(fluidMem,$1000,fluidHook)

label(fluidReturn)
label(fillFluid)
label(original)
label(fullValue)

fluidMem:
  // XMM0 contains the new requested fluid level
  // [RDI+10] contains the current fluid level

  ucomiss xmm0,[rdi+10]

  // Ignore unordered comparisons (NaN)
  jp original

  // New level &gt; current level
  ja fillFluid

  jmp original

fillFluid:
  // Force the fluid to 100%
  movss xmm0,[fullValue]
  movaps xmm6,xmm0
  jmp original

original:
  // Original overwritten instructions
  mov rbx,[rdi+18]
  movss [rdi+10],xmm0

  jmp fluidReturn

align 4
fullValue:
  dd (float)1.0

fluidHook:
  jmp fluidMem
  nop 4

fluidReturn:

[DISABLE]

fluidHook:
  db 48 8B 5F 18 F3 0F 11 47 10

