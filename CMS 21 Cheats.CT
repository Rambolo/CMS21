  <UserdefinedSymbols/>
  <LuaScript>local addressList = getAddressList()

-- Hide the Address column
addressList.Header.Sections[2].Visible = false

-- Hide the Type column
addressList.Header.Sections[3].Visible = false

-- Automatic information visiblity
local master = addressList.getMemoryRecordByDescription(
    "Enable Cheats"
)

local information = addressList.getMemoryRecordByDescription(
    "CMS 21 Cheat Table (v1.1)"
)

if master and information then

    -- Match the initial visibility to the master state
    information.Collapsed = master.Active

    -- When compatibility checks pass and cheats activate
    master.OnActivate = function(memrec, before, currentstate)

        if not before then
            information.Collapsed = true
        end

        return true
    end

    -- When cheats are disabled
    master.OnDeactivate = function(memrec, before, currentstate)

        if not before then
            information.Collapsed = false
        end

        return true
    end

end
</LuaScript>
</CheatTable>
