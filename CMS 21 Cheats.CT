[ENABLE]
 
define(oilHook,GameAssembly.dll+128BA15)

assert(oilHook,F3 0F 58 C6 48 89 6C 24 20)

alloc(oilMem,$1000,oilHook)

label(oilReturn)
label(original)
label(continue)
label(fullLevel)
label(zeroLevel)

oilMem:
  // EBX = CarFluidType
  // EngineOil = 3
  cmp ebx,3
  jne original

  // XMM6 contains the amount being added.
  // Only modify positive refill operations.
  ucomiss xmm6,[zeroLevel]
  jp original
  jbe original

  // Force engine oil to 100%
  movss xmm0,[fullLevel]
  jmp continue

original:
  // Original fluid addition
  addss xmm0,xmm6

continue:
  // Preserve the second overwritten instruction
  mov [rsp+20],rbp

  jmp oilReturn

align 4

fullLevel:
  dd (float)1.0

zeroLevel:
  dd (float)0.0

oilHook:
  jmp oilMem
  nop 4

oilReturn:

[DISABLE]

oilHook:
  db F3 0F 58 C6 48 89 6C 24 20

