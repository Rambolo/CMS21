              <Description>"Examination Repairs Cars"</Description>
              <Color>FF95FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : Car Mechanic Simulator 2021.exe
  Version: 
  Date   : 2026-11-13
  Author : Ram
  Description : 

