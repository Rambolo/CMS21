  <UserdefinedSymbols/>
  <LuaScript>local al = getAddressList()

-- Hide unnecessary columns
al.Header.Sections[2].Visible = false -- Address
al.Header.Sections[3].Visible = false -- Type

-- Automatic information visiblity
local master = al.getMemoryRecordByDescription(
    "Enable Cheats"
)

local information = al.getMemoryRecordByDescription(
    "CMS 21 Cheat Table (v1.1)"
)

if master and information then

    information.Active = true

    -- When compatibility checks pass and cheats activate
    master.OnActivate = function(memrec, before, currentstate)

        if not before then
            information.Collapsed = true
        end

        return true
    end

    -- When cheats are disabled
    master.OnDeactivate = function(memrec, before, currentstate)

        if not before then
            information.Collapsed = false
        end

        return true
    end

end


-- Automatic Cheat Cleanup
-- Restores instructions when CE closes.
if not CMS21_CleanupInstalled then
  CMS21_CleanupInstalled = true

  local addressList = getAddressList()
  local mainForm = getMainForm()
  local previousOnClose = mainForm.OnClose
  local trackedPID = nil

  -- Disable every active cheat, children first.
  local function disableAllCheats()
    local failures = {}

    for i = addressList.Count - 1, 0, -1 do
      local record = addressList[i]

      if record.Active then
        local ok, err = pcall(function()
          record.Active = false
        end)

        if not ok or record.Active then
          table.insert(
            failures,
            record.Description .. ": " .. tostring(err)
          )
        end
      end
    end

    return failures
  end

  -- Called when Cheat Engine is closing.
  mainForm.OnClose = function(sender, closeAction)
    local pid = getOpenedProcessID()
    local processes = getProcesslist()

    -- Game still running
    if pid ~= 0 and processes[pid] ~= nil then
      local failures = disableAllCheats()

      if #failures &gt; 0 then
        showMessage(
          "Some cheats could not be disabled:\n" ..
          table.concat(failures, "\n") ..
          "\n\nDisable them manually before exiting."
        )
        return caNone
      end
    else
      -- Process is gone. only reset checkbox states.
      addressList.disableAllWithoutExecute()
    end

    -- Preserve Cheat Engine's existing close handler.
    if previousOnClose then
      return previousOnClose(sender, closeAction)
    end

    return closeAction or caFree
  end
end
</LuaScript>
</CheatTable>
