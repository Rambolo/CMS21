[ENABLE]

define(repairHook,GameAssembly.dll+4F30D0)

assert(repairHook,40 53 57 48 83 EC 28)

alloc(repairMem,$1000,repairHook)

label(return)
label(skipRepair)
label(repairDone)
label(fullCondition)

repairMem:

  // Original ShowCarConditions() prologue
  push rbx
  push rdi
  sub rsp,28

  // Execute once per activation
  cmp byte ptr [repairDone],01
  je skipRepair

  // RCX = current CarLoader
  test rcx,rcx
  je skipRepair

  // Check that the car has finished loading
  cmp byte ptr [rcx+631],01
  jne skipRepair

  // Check that the car root exists
  cmp qword ptr [rcx+178],00
  je skipRepair

  // Prevent repeated or recursive execution
  mov byte ptr [repairDone],01

  // Preserve the CarLoader pointer and stack alignment
  push rcx
  sub rsp,28

  // Repair mechanical parts
  movss xmm1,[fullCondition]
  xor edx,edx
  call GameAssembly.dll+4EF7E0

  // Repair body panels
  mov rcx,[rsp+28]
  movss xmm1,[fullCondition]
  xor edx,edx
  call GameAssembly.dll+50BBC0

  // Restore original RCX
  add rsp,28
  pop rcx

skipRepair:
  jmp return

align 4
repairDone:
  db 00

align 4
fullCondition:
  dd (float)1.0

repairHook:
  jmp repairMem
  nop 2

return:

[DISABLE]

repairHook:
  db 40 53 57 48 83 EC 28

dealloc(repairMem)

