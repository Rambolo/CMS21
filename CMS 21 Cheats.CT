            <CheatEntry NoScriptTag="1">
              <ID>62</ID>
              <Description>"Auto Buy Shopping List"</Description>
              <Color>FF95FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : Car Mechanic Simulator 2021.exe
  Version: 
  Date   : 2026-11-13
  Author : Ram
  Description : 

  &lt;Optional info&gt;
}

[ENABLE]

define(hook,GameAssembly.dll+DAD710)

assert(hook,48 89 5C 24 18)

alloc(newmem,2048,hook)

label(original)
label(fallback)
label(purchased)

newmem:
  // Preserve registers and align the stack
  push rbx
  push rsi
  push rdi
  push r12
  push r13
  push r14
  push r15
  sub rsp,80

  // Save original function arguments
  mov [rsp+40],rcx
  mov [rsp+48],rdx
  mov [rsp+50],r8
  mov [rsp+58],r9

  mov r12,rdx           // Item ID
  mov r13,r9            // Additional item data

  test r12,r12
  je fallback

  test r13,r13
  je fallback

  // Initially exclude specialised items
  cmp byte ptr [r13+08],00  // Licence plate
  jne fallback

  cmp byte ptr [r13+09],00  // Tyre
  jne fallback

  cmp byte ptr [r13+0A],00  // Rim
  jne fallback

  // Get GameInventory.Instance
  xor ecx,ecx
  call GameAssembly.dll+102CA20

  test rax,rax
  je fallback

  // Retrieve the part's property information
  mov rcx,rax
  mov rdx,r12
  xor r8d,r8d
  call GameAssembly.dll+1030780

  test rax,rax
  je fallback

  // Additional protection against wheel items
  cmp byte ptr [rax+30],06
  je fallback

  cmp byte ptr [rax+30],07
  je fallback

  // PartProperty.Price
  mov ebx,[rax+18]

  test ebx,ebx
  jle fallback

  // Access GlobalData static fields
  mov rax,[GameAssembly.dll+2807F98]
  test rax,rax
  je fallback

  mov rax,[rax+B8]
  test rax,rax
  je fallback

  // Check whether player can afford the part
  cmp dword ptr [rax+2A0],ebx
  jl fallback

  // Obtain GameManager.Instance
  mov rcx,[GameAssembly.dll+28080E0]
  test rcx,rcx
  je fallback

  call GameAssembly.dll+14ED8C0

  test rax,rax
  je fallback

  // GameManager.Inventory
  mov rdi,[rax+18]
  test rdi,rdi
  je fallback

  // Allocate a new Item instance
  mov rcx,[GameAssembly.dll+2806170]
  test rcx,rcx
  je fallback

  call GameAssembly.dll+2B6080

  test rax,rax
  je fallback

  mov rsi,rax

  // Item constructor: Item(string id)
  mov rcx,rsi
  mov rdx,r12
  xor r8d,r8d
  call GameAssembly.dll+C87260

  // Match normal shop item defaults
  mov dword ptr [rsi+28],3F800000
  mov byte ptr [rsi+30],01
  mov byte ptr [rsi+A0],00
  mov dword ptr [rsi+B8],3F800000

  // Add the purchased item to player inventory
  mov rcx,rdi
  mov rdx,rsi
  xor r8d,r8d
  xor r9d,r9d
  call GameAssembly.dll+C79640

  // Deduct the part's price
  mov ecx,ebx
  neg ecx
  xor edx,edx
  call GameAssembly.dll+D7B580

  // Purchase complete - do not add to shopping list
  jmp purchased

fallback:
  mov rcx,[rsp+40]
  mov rdx,[rsp+48]
  mov r8,[rsp+50]
  mov r9,[rsp+58]

  add rsp,80
  pop r15
  pop r14
  pop r13
  pop r12
  pop rdi
  pop rsi
  pop rbx

  jmp original

purchased:
  add rsp,80
  pop r15
  pop r14
  pop r13
  pop r12
  pop rdi
  pop rsi
  pop rbx

  ret

original:
  mov [rsp+18],rbx
  jmp GameAssembly.dll+DAD715

hook:
  jmp newmem

[DISABLE]

hook:
  db 48 89 5C 24 18

dealloc(newmem)

