assert(repairHook,E8 98 2D 00 00)
assert(scrapHook,E8 B7 2B 00 00)

// Allocate near their respective hooks
alloc(repairMem,$1000,repairHook)
alloc(scrapMem,$1000,scrapHook)

label(repairReturn)
label(scrapReturn)

////////////////////////////////////
// REPAIR MINIGAME
////////////////////////////////////

repairMem:

  // Original call:
  // RepairPartWindow.CurrentBarMovement()
  call GameAssembly.dll+1B03BA0

  // RCX = RepairPartWindow instance
  mov rcx,rbx

  // Null IL2CPP MethodInfo argument
  xor edx,edx

  // Stop the minigame immediately
  call GameAssembly.dll+1B00E50

  jmp repairReturn

repairHook:
  jmp repairMem

repairReturn:

////////////////////////////////////
// SCRAP PRODUCTION MINIGAME
////////////////////////////////////

scrapMem:

  // Original call:
  // ScrapProduction.CurrentBarMovement()
  call GameAssembly.dll+BC87C0

  // RCX = ScrapProduction instance
  mov rcx,rbx

  // Null IL2CPP MethodInfo argument
  xor edx,edx

  // Stop the minigame immediately
  call GameAssembly.dll+BC5C50

  jmp scrapReturn

scrapHook:
  jmp scrapMem

scrapReturn:

